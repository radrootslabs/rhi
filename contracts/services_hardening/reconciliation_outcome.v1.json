  "forbidden": [
    "caller_supplied_coverage",
    "caller_supplied_outcome",
    "caller_supplied_reason",
    "evidence_absence_as_invalid",
    "valid_or_invalid_without_scope_satisfied",
    "raw_source_error_reason",
    "report_or_attestation_construction",
    "persistence_or_job_finalization"
  ],
  "deferred": [
    "generation_fenced_commit",
    "report_and_attestation",
    "manifest_projection_and_report_persistence",
